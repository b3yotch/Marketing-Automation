# Passed to docker compose via --env-file (see docker-compose.langfuse.yml).
# These LANGFUSE_INIT_* values make Langfuse create the org, project, user and
# API key pair on FIRST boot, so there is no sign-up/click-through step. You are
# not fetching keys from anyone - you are choosing them here. They only take
# effect on an empty database; changing them later does not rotate existing keys.
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local
LANGFUSE_INIT_PROJECT_ID=creative-workflow
LANGFUSE_INIT_PROJECT_NAME=creative-workflow
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-creative-workflow
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-creative-workflow
LANGFUSE_INIT_USER_EMAIL=you@local.dev
LANGFUSE_INIT_USER_NAME=local
LANGFUSE_INIT_USER_PASSWORD=change-me-before-first-boot